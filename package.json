{
  "version": "1.2",
  "author": "Doug Kent",
  "description": "Data-driven Resume by and for Douglas Kent",
  "repository": {
    "type": "git",
    "url": "https://github.com/dkent600/douglaskent.git"
  },
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "debug": "vite",
    "start": "vite --open",
    "admin": "vite --open /admin",
    "build": "cross-env NODE_ENV=production vite build",
    "predeploy": "powershell -NoProfile -ExecutionPolicy Bypass -File validate-web-config.ps1",
    "deploy": "ftp -i -s:ftpDeploy.txt",
    "preview": "vite preview --open",
    "clean": "npx -y rimraf node_modules package-lock.json && npm i",
    "lint:js": "eslint src --ext .js,.ts",
    "lint:js.fix": "eslint src --ext .js,.ts --fix",
    "lint:css": "sass-lint -c .sass-lint.yml \"src/**/*.scss\"",
    "lint:html": "htmlhint -c .htmlhintrc src",
    "lint": "npm run lint:js && npm run lint:html && npm run lint:css",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@aurelia/router": "2.0.0-rc.2",
    "arrive": "^2.4.1",
    "aurelia": "2.0.0-rc.2",
    "bootstrap": "^4.1.1",
    "bootstrap-material-design": "^4.1.1",
    "dompurify": "^3.0.1",
    "jquery": "^3.2.1",
    "node-waves": "^0.7.5",
    "popper.js": "^1.11.0"
  },
  "devDependencies": {
    "@aurelia/vite-plugin": "2.0.0-rc.2",
    "@types/bootstrap": "^3.3.36",
    "@types/jquery": "^3.2.13",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "autoprefixer": "^10.4.13",
    "cross-env": "^7.0.3",
    "docx": "^9.7.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "latest",
    "eslint-import-resolver-typescript": "latest",
    "eslint-plugin-import": "latest",
    "eslint-plugin-prettier": "latest",
    "eslint-plugin-simple-import-sort": "latest",
    "eslint-plugin-unused-imports": "^3.0.0",
    "htmlhint": "^1.1.4",
    "jszip": "^3.10.1",
    "postcss": "^8.4.20",
    "postcss-url": "^10.1.3",
    "rollup-plugin-visualizer": "^7.1.1",
    "rollup-pluginutils": "^2.8.2",
    "sass": "^1.103.1",
    "sass-lint": "^1.13.1",
    "terser": "^5.31.0",
    "tslib": "^2.4.1",
    "typescript": "6.0.3",
    "vite": "^7.3.6"
  },
  "overrides": {
    "chokidar": "^3.5.3",
    "glob-stream": "^7.0.0",
    "glob-parent": "^6.0.2",
    "micromatch": "^4.0.5"
  }
}
